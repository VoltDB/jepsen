+int LazyFS::lfs_statfs (const char* path, struct statvfs* stbuf) {
+
+    if (this_ ()->FSConfig->log_all_operations) {
+        spdlog::info ("[lazyfs.ops]: {}(path={})", __FUNCTION__, path);
+    }
+
+    // Report the backing filesystem's sizes, as passthrough FUSE filesystems
+    // do. Data still in the cache is not counted against free space.
+    int res = statvfs (path, stbuf);
+    if (res == -1)
+        return -errno;
+
+    return 0;
+}
